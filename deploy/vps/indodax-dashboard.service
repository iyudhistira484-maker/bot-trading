[Unit]
Description=Indodax Paper Dashboard (Localhost Only)
After=network.target

[Service]
Type=simple
User=indodaxbot
Group=indodaxbot
WorkingDirectory=/home/indodaxbot/indodax-bot
Environment=HOME=/home/indodaxbot PYTHONUNBUFFERED=1
ExecStart=/home/indodaxbot/indodax-bot/.venv/bin/python -m src.dashboard serve
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
